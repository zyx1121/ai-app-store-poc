{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI App Store",
  "version": "0.1.0",
  "identifier": "tw.zyx.ai-app-store",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI App Store",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Loki",
    "shortDescription": "One-click local AI app store for Hugging Face models and Spaces",
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
